library IEEE;

use IEEE.STD_LOGIC_1164.ALL;

use IEEE.NUMERIC_STD.ALL;



entity PWM_Generator is

    Generic (

        -- สมมติ Clock 20MHz อยากได้ความถี่ PWM ที่ 20kHz 

        -- เอา 20,000,000 / 20,000 = 1000

        MAX_COUNT : integer := 1000 

    );

    Port (

        clk         : in  STD_LOGIC;

        rst         : in  STD_LOGIC;

        duty_cycle  : in  integer range 0 to MAX_COUNT; -- รับค่าความเร็ว 0 ถึง 1000

        pwm_out     : out STD_LOGIC

    );

end PWM_Generator;



architecture Behavioral of PWM_Generator is

    signal counter : integer range 0 to MAX_COUNT - 1 := 0;

begin

    process(clk, rst)

    begin

        if rst = '1' then

            counter <= 0;

            pwm_out <= '0';

        elsif rising_edge(clk) then

            -- 1. ให้นับค่าขึ้นเรื่อยๆ จนถึง MAX_COUNT แล้วรีเซ็ตกลับเป็น 0

            if counter = MAX_COUNT - 1 then

                counter <= 0;

            else

                counter <= counter + 1;

            end if;



            -- 2. สร้างสัญญาณ PWM: ถ้าตัวนับน้อยกว่า Duty Cycle ให้เป็น '1' (มอเตอร์หมุน)

            if counter < duty_cycle then

                pwm_out <= '1';

            else

                pwm_out <= '0'; -- ถ้านอกนั้นให้เป็น '0' (มอเตอร์หยุด)

            end if;

        end if;

    end process;

end Behavioral;
