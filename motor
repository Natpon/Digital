library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.STD_LOGIC_UNSIGNED.ALL;

entity Elevator_Motor is
    Port ( 
        clk       : in  STD_LOGIC; -- Clock หลักบอร์ด
        btn_up    : in  STD_LOGIC; -- ปุ่มกดขึ้น
        btn_down  : in  STD_LOGIC; -- ปุ่มกดลง
        IN1       : out STD_LOGIC;
        IN2       : out STD_LOGIC;
        ENA       : out STD_LOGIC
    );
end Elevator_Motor;

architecture Behavioral of Elevator_Motor is
    -- *** ปรับความเร็วตรงนี้ (0-255) ***
    -- 255 คือเร็วสุด / 128 คือครึ่งนึง / 64 คือช้ามาก
    constant LIFT_SPEED : STD_LOGIC_VECTOR(7 downto 0) := "01000000"; -- ตัวอย่างตั้งไว้ที่ 64 (ช้าลง 4 เท่า)

    signal clk_pwm    : STD_LOGIC := '0';
    signal pwm_count  : STD_LOGIC_VECTOR(7 downto 0) := (others => '0');
    signal div_count  : integer range 0 to 2500 := 0;
begin

    -- ส่วนลดความถี่เพื่อให้ L298N ทำงานได้ (Clock Divider)
    process(clk)
    begin
        if rising_edge(clk) then
            if div_count = 2500 then
                div_count <= 0;
                clk_pwm <= not clk_pwm;
            else
                div_count <= div_count + 1;
            end if;
        end if;
    end process;

    -- ส่วนคุมทิศทางลิฟต์ (กดปุ่มไหนไปทางนั้น)
    process(btn_up, btn_down)
    begin
        if btn_up = '1' and btn_down = '0' then
            IN1 <= '1'; IN2 <= '0';
        elsif btn_up = '0' and btn_down = '1' then
            IN1 <= '0'; IN2 <= '1';
        else
            IN1 <= '0'; IN2 <= '0'; -- หยุด
        end if;
    end process;

    -- *** ส่วนที่คุมความเร็วที่คุณอยากรู้ ***
    process(clk_pwm)
    begin
        if rising_edge(clk_pwm) then
            pwm_count <= pwm_count + 1;
            
            -- ใช้ค่าคงที่ LIFT_SPEED ที่เราตั้งไว้มาเทียบ
            if pwm_count < LIFT_SPEED then
                ENA <= '1'; -- จ่ายไฟ
            else
                ENA <= '0'; -- ตัดไฟ
            end if;
        end if;
    end process;

end Behavioral;
